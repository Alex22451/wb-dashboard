generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entrepreneur {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  wbApiKey String?
  wbPromotionApiKey String?
  userId   Int?
  user     User?        @relation(fields: [userId], references: [id])
  orders   DailyOrder[]
  adSpends AdSpend[]
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  entrepreneurs Entrepreneur[]
}

model Product {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  orders   DailyOrder[]
  mappings ProductMapping[]
}

model DailyOrder {
  id             Int           @id @default(autoincrement())
  entrepreneurId Int
  productId      Int
  date           DateTime
  quantity       Int           @default(0)
  entrepreneur   Entrepreneur  @relation(fields: [entrepreneurId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])

  @@unique([entrepreneurId, productId, date])
}

model AdSpend {
  id             Int          @id @default(autoincrement())
  entrepreneurId Int
  year           Int
  month          Int
  budget         Int?
  actual         Int?
  entrepreneur   Entrepreneur @relation(fields: [entrepreneurId], references: [id])

  @@unique([entrepreneurId, year, month])
}

model ProductMapping {
  id                Int    @id @default(autoincrement())
  entrepreneurId    Int
  productId         Int
  wbNmId            Int    @default(0)
  wbSupplierArticle String @default("")
  wbSubject         String @default("")
  wbCategory        String @default("")
  product           Product @relation(fields: [productId], references: [id])

  @@unique([entrepreneurId, productId])
}
